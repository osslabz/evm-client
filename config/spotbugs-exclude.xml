<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- public API: Chain is mutable through its generated setId, and callers pass the shared Chain constants. -->
    <Match>
        <Class name="net.osslabz.evmclient.EvmClient"/>
        <Method name="&lt;init&gt;" params="net.osslabz.evmclient.dto.Chain,org.web3j.protocol.Web3jService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- public API: Chain is mutable through its generated setId, and callers pass the shared Chain constants. -->
    <Match>
        <Class name="net.osslabz.evmclient.dto.Coin"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- public API: Erc20Token is mutable through the setters it inherits from PrimaryCoin. -->
    <Match>
        <Class name="net.osslabz.evmclient.dto.Erc20TokenBalance"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
